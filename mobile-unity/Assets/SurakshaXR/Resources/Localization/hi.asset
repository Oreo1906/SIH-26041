      m_Items: []
  - m_Id: 646657468174338
    m_Localized: "\u0906\u092A\u0915\u0947 \u091A\u093E\u0930\u094B\u0902 \u0913\u0930
      \u0906\u092D\u093E\u0938\u0940 \u0916\u0926\u093E\u0928 \u0926\u093F\u0916\u093E\u0908
      \u0926\u0947\u0917\u0940\u0964 \u092C\u093E\u0927\u093E-\u0930\u0939\u093F\u0924
      \u091C\u0917\u0939 \u092E\u0947\u0902 \u0926\u0947\u0916\u0915\u0930 \u091A\u0932\u0947\u0902
      \u092F\u093E \u091C\u0949\u092F\u0938\u094D\u091F\u093F\u0915 \u0938\u0947
      \u0906\u0917\u0947 \u092C\u0922\u093C\u0947\u0902\u0964 \u0905\u0938\u0932\u0940
      \u092C\u093E\u0927\u093E\u090F\u0901 \u0926\u0947\u0916\u0928\u0947 \u0915\u0947
      \u0932\u093F\u090F \u2018\u0906\u0938\u092A\u093E\u0938 \u0926\u0947\u0916\u0947\u0902\u2019
      \u0926\u092C\u093E\u090F\u0901\u0964 \u092E\u094C\u091C\u0942\u0926\u093E \u0915\u093E\u0930\u094D\u092F
      \u0915\u0947 \u091A\u092E\u0915\u0940\u0932\u0947 \u0938\u0941\u0928\u0939\u0930\u0947
      \u0928\u093F\u0936\u093E\u0928 \u0924\u0915 \u091C\u093E\u090F\u0901\u0964
      \u092F\u0939 \u092B\u093C\u0930\u094D\u0936 \u0906\u092D\u093E\u0938\u0940
      \u0939\u0948; \u0907\u0938\u0947 \u0915\u092E\u0930\u0947 \u0915\u0940 \u0935\u093E\u0938\u094D\u0924\u0935\u093F\u0915
      \u092E\u093E\u092A \u0938\u0947 \u0928\u0939\u0940\u0902 \u092C\u0928\u093E\u092F\u093E
      \u0917\u092F\u093E \u0939\u0948\u0964"

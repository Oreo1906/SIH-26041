{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surakshaxr.local/schemas/scenario.schema.json",
  "title": "SurakshaXR Scenario",
  "type": "object",
  "required": [
    "scenarioId",
    "moduleId",
    "version",
    "titleKey",
    "objectives",
    "anchors",
    "entities",
    "steps",
    "scoring",
    "contentValidation"
  ],
  "properties": {
    "scenarioId": {
      "type": "string",
      "minLength": 1
    },
    "moduleId": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "minLength": 1
    },
    "titleKey": {
      "type": "string",
      "minLength": 1
    },
    "descriptionKey": {
      "type": "string"
    },
    "objectives": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "minItems": 1
    },
    "anchors": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "entities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/entity"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1
    },
    "scoring": {
      "$ref": "#/$defs/scoring"
    },
    "contentValidation": {
      "$ref": "#/$defs/contentValidation"
    }
  },
  "$defs": {
    "anchor": {
      "type": "object",
      "required": [
        "id",
        "simPosition"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "simPosition": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "simRotationEuler": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 3,
          "maxItems": 3
        },
        "arPlacementHint": {
          "type": "string",
          "enum": [
            "floor",
            "wall",
            "relative",
            "free"
          ]
        }
      }
    },
    "entity": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "anchorId"
      ],
      "properties": {
        "id": {
          "type": "string"
        },
        "kind": {
          "type": "string"
        },
        "anchorId": {
          "type": "string"
        },
        "prefabKey": {
          "type": "string"
        },
        "labelKey": {
          "type": "string"
        },
        "initiallyVisible": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "action": {
      "type": "object",
      "required": [
        "actionId",
        "result"
      ],
      "properties": {
        "actionId": {
          "type": "string"
        },
        "result": {
          "type": "string",
          "enum": [
            "correct",
            "incorrect",
            "neutral"
          ]
        },
        "scoreDelta": {
          "type": "number"
        },
        "feedbackKey": {
          "type": "string"
        },
        "weakTopicTags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "nextStepId": {
          "type": [
            "string",
            "null"
          ]
        },
        "criticalFail": {
          "type": "boolean"
        }
      }
    },
    "step": {
      "type": "object",
      "required": [
        "stepId",
        "objectiveKey",
        "allowedActions"
      ],
      "properties": {
        "stepId": {
          "type": "string"
        },
        "objectiveKey": {
          "type": "string"
        },
        "narrationKey": {
          "type": "string"
        },
        "timeLimitSec": {
          "type": [
            "number",
            "null"
          ]
        },
        "allowedActions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/action"
          },
          "minItems": 1
        },
        "visualCommands": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": true
          }
        }
      }
    },
    "scoring": {
      "type": "object",
      "required": [
        "passThreshold",
        "categories"
      ],
      "properties": {
        "passThreshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "categories": {
          "type": "object",
          "additionalProperties": {
            "type": "number"
          }
        },
        "criticalFailForcesFail": {
          "type": "boolean",
          "default": true
        }
      }
    },
    "contentValidation": {
      "type": "object",
      "required": [
        "status",
        "version"
      ],
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "demo-unvalidated",
            "review-pending",
            "validated"
          ]
        },
        "version": {
          "type": "string"
        },
        "reviewer": {
          "type": [
            "string",
            "null"
          ]
        },
        "reviewedAt": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}

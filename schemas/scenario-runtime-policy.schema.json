{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surakshaxr.local/schemas/scenario-runtime-policy.schema.json",
  "title": "Scenario runtime policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["scenarioId", "scenarioVersion", "entryStepId", "terminalStepIds", "actionCategories"],
  "properties": {
    "scenarioId": { "type": "string", "minLength": 1 },
    "scenarioVersion": { "type": "string", "minLength": 1 },
    "entryStepId": { "type": "string", "minLength": 1 },
    "terminalStepIds": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "actionCategories": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } }
  }
}

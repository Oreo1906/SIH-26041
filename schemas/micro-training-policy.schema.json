{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://surakshaxr.local/schemas/micro-training-policy.schema.json",
  "title": "Bundled micro-training mapping",
  "type": "object",
  "additionalProperties": false,
  "required": ["moduleId", "generalStepIds", "topicSteps", "maximumTopics", "questionCount"],
  "properties": {
    "moduleId": {"type": "string", "minLength": 1},
    "generalStepIds": {"type": "array", "minItems": 1, "maxItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "topicSteps": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}},
    "maximumTopics": {"type": "integer", "minimum": 1, "maximum": 2},
    "questionCount": {"type": "integer", "minimum": 2, "maximum": 3}
  }
}
